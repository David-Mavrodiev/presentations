                <div class="figure-frame"><img src="images/thesis/experiment/vessel_squeeze_step19_jaw.png" alt="step 19"/></div>
                <div class="figure-caption" data-lang="en">t = 19 · held steady</div>
                <div class="figure-caption" data-lang="bg">t = 19 · стабилно задържане</div>
              </div>
