          </div>
        </div>
      </section>


    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <script>
    // --- Fit utilities (declared first so the bilingual IIFE can call queueFitSlides) ---
    function fitSlides() {
      document.querySelectorAll('.reveal .slides section').forEach((slide) => {
        const shell = slide.querySelector('.slide-shell, .section-shell');
        if (!shell) return;
        shell.style.setProperty('--fit-scale', '1');
        const slideStyle = getComputedStyle(slide);
        const availableWidth = slide.clientWidth - parseFloat(slideStyle.paddingLeft) - parseFloat(slideStyle.paddingRight);
        const availableHeight = slide.clientHeight - parseFloat(slideStyle.paddingTop) - parseFloat(slideStyle.paddingBottom);
        const neededWidth = shell.scrollWidth;
        const neededHeight = shell.scrollHeight;
        const fitScale = Math.min(1, availableWidth / neededWidth, availableHeight / neededHeight);
        shell.style.setProperty('--fit-scale', String(Math.max(0.1, fitScale)));
      });
    }

    let fitFrame = 0;
    function queueFitSlides() {
      cancelAnimationFrame(fitFrame);
      fitFrame = requestAnimationFrame(fitSlides);
    }

    // Bilingual toggle
    (function () {
      const KEY = 'surgicalRLPresentationLang';
      const supported = ['en', 'bg'];
      const initial = supported.includes(localStorage.getItem(KEY))
        ? localStorage.getItem(KEY)
        : 'en';

      function setLang(lang) {
        if (!supported.includes(lang)) return;
        document.documentElement.lang = lang;
        localStorage.setItem(KEY, lang);
        document.querySelectorAll('#lang-toggle button').forEach(b => {
          b.classList.toggle('active', b.dataset.setLang === lang);
        });
        if (window.Reveal && window.Reveal.layout) {
          window.Reveal.layout();
        }
        queueFitSlides();
      }

      document.querySelectorAll('#lang-toggle button').forEach(b => {
        b.addEventListener('click', () => setLang(b.dataset.setLang));
      });

      setLang(initial);
    })();

    const deck = new Reveal(document.querySelector('.reveal'), {
      hash: true,
      controls: true,
      progress: true,
      center: false,
      slideNumber: 'c/t',
      transition: 'slide',
      backgroundTransition: 'fade',
      width: 1280,
      height: 720,
      margin: 0.05,
      minScale: 0.1,
      maxScale: 1.35
    });

    function renderMath(scope) {
      if (window.renderMathInElement) {
        renderMathInElement(scope || document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$',  right: '$',  display: false }
          ],
          throwOnError: false
        });
      }
    }

    deck.initialize().then(() => {
      renderMath();
      fitSlides();
      document.fonts?.ready.then(fitSlides);
    });
    deck.on('slidechanged', (event) => {
      renderMath(event.currentSlide);
      queueFitSlides();
    });
    deck.on('ready', queueFitSlides);
    window.addEventListener('resize', queueFitSlides);
  </script>
</body>
</html>
